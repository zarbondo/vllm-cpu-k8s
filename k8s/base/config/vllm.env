# Environment of both containers (ConfigMap vllm-env).
# Change a value and run `kubectl apply -k ...`: the ConfigMap gets a new
# hash-suffixed name and the Deployment rolls out by itself.

# Model on Hugging Face. Pin MODEL_REVISION to a commit sha for a reproducible
# deployment; changing the model or revision makes the init container fetch it again.
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MODEL_REVISION=main
# Name clients put into the "model" field of requests
SERVED_MODEL_NAME=qwen2.5-1.5b-instruct

# CPU runtime. "nobind": OpenMP thread count follows the pod CPU limit
# (one core is kept for the API server). On nodes with the static CPU manager
# and Guaranteed QoS, "auto" binds threads to the exclusive cores instead.
VLLM_CPU_OMP_THREADS_BIND=nobind
# Loading + torch.compile on a laptop CPU can take several minutes
VLLM_ENGINE_READY_TIMEOUT_S=1200
